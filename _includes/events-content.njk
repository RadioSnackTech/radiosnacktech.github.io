---
layout: base.njk
title: Events - Radio Snack
permalink: /events/
---

{% set isFr = page.lang == "fr" %}
{% set today = "" | currentDate %}
{% set upcomingEvents = [] %}
{% set pastEvents = [] %}

{%- for eventKey, event in events %}
  {% if event.date > today %}
    {% set upcomingEvents = upcomingEvents.concat([event]) %}
  {% else %}
    {% set pastEvents = pastEvents.concat([event]) %}
  {% endif %}
{%- endfor %}

{# soonest first #}
{% set upcomingEvents = upcomingEvents | sort(false, false, 'date') %}

{# most recent first #}
{% set pastEvents = pastEvents | sort(true, false, 'date') %}

<h2>{{ translations[page.lang].events.upcoming}}</h2>

<div class="events-list">
  {% if upcomingEvents.length > 0 %}
    {%- for event in upcomingEvents %}
    <a href="{{ (event.url_fr if isFr and event.url_fr else event.url) }}" {% if event.url[0] != "/" %}target="_blank" rel="noopener"{% endif %}>
    <article class="event">
      <img src="{{ (event.image_fr if isFr and event.image_fr else event.image) }}" alt="{{ (event.title_fr if isFr and event.title_fr else event.title) }}">
      <h2>{{ (event.title_fr if isFr and event.title_fr else event.title) }}</h2>

      {% if event.no_registration %}
      <div class="note"> {{ translations[page.lang].events.no_registration}} </div>
      {% elif event.coming_soon %}
      <div class="note coming-soon"> {{ translations[page.lang].events.coming_soon }}</div>
      {% endif %}

      <time datetime="{{ event.date }}">{{ event.date | formatEventDate }}</time>

    </article>
    </a>
    {%- endfor %}
  {% else %}
    <p>No events right now, <a style="color: var(--green);" href="https://space.us17.list-manage.com/subscribe?u=ba0a970b8d0ce98df253de379&id=44959ac275">sign up for our mailing list</a> to hear about new events!</p>
  {% endif %}
</div>

<h2>{{ translations[page.lang].events.drop_in }}</h2>

<div class="events-list drop-in-events">
  {%- for item in translations[page.lang].events.drop_in_list %}
  <a href="{{ item.url }}">
  <article class="event">
    <img src="{{ item.image }}" alt="{{ item.title }}">
    <h2>{{ item.title }}</h2>
    <time>{{ item.schedule }}</time>
  </article>
  </a>
  {%- endfor %}
</div>

<h2>{{ translations[page.lang].events.past}}</h2>

<div class="events-list">
  {%- for event in pastEvents %}
  <a href="{{ (event.url_fr if isFr and event.url_fr else event.url) }}" {% if event.url[0] != "/" %}target="_blank" rel="noopener"{% endif %}>
  <article class="event">
    <img src="{{ (event.image_fr if isFr and event.image_fr else event.image) }}" alt="{{ (event.title_fr if isFr and event.title_fr else event.title) }}">
    <h2>{{ (event.title_fr if isFr and event.title_fr else event.title) }}</h2>
    <time datetime="{{ event.date }}">{{ event.date | formatEventDate }}</time>
  </article>
  </a>
  {%- endfor %}
</div>
